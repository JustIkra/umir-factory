# UMIR_BIND sets the frontend address only. The legacy gateway port stays on 127.0.0.1; publish it
# deliberately with compose.legacy-public.yaml (isolated network only). Prefer compose.completion.yaml.
UMIR_BIND=127.0.0.1
UMIR_WEB_PORT=8080
UMIR_API_PORT=8081
# Operator auth candidate (compose.auth.yaml, gateway#8). The origin is the exact frontend address in the
# browser; this candidate always runs in loopback-development mode. The public VM assembly uses
# OPERATOR_COOKIE_MODE=secure and OPERATOR_PUBLIC_ORIGIN=https://<domain as A-label>. The bootstrap values
# are read only when the account file does not exist yet.
# OPERATOR_PUBLIC_ORIGIN=http://127.0.0.1:8080
# OPERATOR_BOOTSTRAP_LOGIN=operator
# OPERATOR_BOOTSTRAP_DISPLAY_NAME=Оператор
# OPERATOR_BOOTSTRAP_PASSWORD_HASH='<PHC string from hash-password>'

# FIN1 candidate: prepare a separate private bundle first. These values do not select production pins.
# COMPLETION_PRIVATE_DIR=/absolute/private/completion
# COMPLETION_ORIGIN=https://example.org
# COMPLETION_COOKIE_MODE=secure
# COMPLETION_WEB_PORT=8080
# COMPLETION_BIND=127.0.0.1
# Set the exact trusted private interface address when an external TLS proxy connects to this VM.
# COMPLETION_SOURCES=/absolute/checkouts/containing/auth/warehouse/serving/gateway/frontend
# Optional Feedback keeps its existing external SMTP/Telegram requirements.
# COMPLETION_FEEDBACK_ENV_FILE=/absolute/private/feedback.env
# COMPLETION_FEEDBACK_IMAGE=ghcr.io/justikra/umir-feedback:sha-<full-reviewed-SHA>
