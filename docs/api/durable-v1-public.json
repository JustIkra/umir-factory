            }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "operation"
          ],
          "properties": {
            "operation": {
              "const": "expiry.due"
            }
          }
        }
      ]
    },
    "ServiceClaims": {
