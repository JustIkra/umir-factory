        }
      }
    },
    "DurableResult": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "commandID",
        "outcome",
        "aggregateRevision",
        "resourceID",
        "mailJobs"
      ],
      "properties": {
        "commandID": {
          "$ref": "#/components/schemas/ClientCommandID"
        },
        "outcome": {
          "type": "string",
          "const": "committed"
        },
        "aggregateRevision": {
          "$ref": "#/components/schemas/Version",
          "description": "Monotonic database sequence value of the aggregate at commit. Values are not consecutive; consumers must not infer missing events from gaps (C30). Continuity is guaranteed only for warehouse.* events."
        },
        "resourceID": {
          "$ref": "#/components/schemas/EntityID"
        },
        "mailJobs": {
          "type": "array",
          "items": {
            "$ref": "#/components/schemas/MailJob"
          },
          "minItems": 0,
          "maxItems": 500
        }
      }
    },
    "Epoch": {
      "$ref": "#/components/schemas/EntityID",
      "description": "Storage generation (R2, C9). A UUID that the owning service creates in its first migration and stores with its data (storage_meta). It changes only when the storage is reset or restored to an earlier history (generation rotate by the owner under the owner role), never on a process restart, redeploy or replica change. Warehouse, Serving and Auth each have their own generation. runtimeEpoch, readerEpoch, expectedEpoch, currentEpoch and X-Umir-Runtime-Epoch carry it; the UUID format is unchanged. The replica identifier (INSTANCE_ID) is not an epoch: it appears only in /readyz, logs, the SSE epoch and the stream cursor of the edge service (C19). RuntimeReset is returned only after a confirmed generation reset."
    },
    "Error": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "code",
        "outcome",
        "message",
        "retryable"
      ],
      "properties": {
        "code": {
          "type": "string",
          "enum": [
            "InvalidArgument",
            "Unauthenticated",
            "InvalidOrigin",
            "InvalidCsrfToken",
            "Forbidden",
            "AuthUnavailable",
            "AuthStorageUnavailable",
            "AuthUpdateOutcomeUnknown",
            "CommandConflict",
            "LastAdmin",
            "ScopeDeleted",
            "RuntimeNotReady",
            "RuntimeReset",
            "SettingsChanged",
            "UnknownTimeZone",
            "TimeZoneDataUnavailable",
            "AmbiguousLocalTime",
            "NonexistentLocalTime",
            "SkippedDate",
            "RefreshRequired",
            "UnknownEventSchema",
            "CalculationUnavailable",
            "ProductConflict",
            "DishConflict",
            "BatchNotFound",
            "NotPendingWriteoff",
            "AlreadyWrittenOff",
            "InvitationExpired",
            "InvitationRevoked",
            "RateLimited",
            "ChallengeLocked",
            "InvalidProof",
            "DeliveryUnavailable",
            "UpstreamUnavailable",
            "InvalidRequest",
            "InvalidCredentials",
            "CurrentPasswordIncorrect",
            "NotFound",
            "MethodNotAllowed",
            "PayloadTooLarge",
            "UnsupportedMediaType",
            "InvalidDisplayName",
            "PasswordRejected",
            "LoginRateLimited",
            "PasswordChangeRateLimited",
            "FeedbackRateLimited",
            "SessionStorageUnavailable",
            "SessionUpdateOutcomeUnknown",
            "AccountStorageUnavailable",
            "AccountUpdateOutcomeUnknown",
            "ProposalNotFound",
            "InventoryUnavailable",
            "TechnicalError",
            "UpstreamTimeout",
            "ServiceUnavailable",
            "InvalidToken",
            "LimitExceeded"
          ]
        },
        "outcome": {
          "$ref": "#/components/schemas/Outcome"
        },
        "message": {
          "type": "string"
        },
        "retryable": {
          "type": "boolean"
        },
        "details": {
          "type": "object",
          "additionalProperties": false,
          "required": [],
          "properties": {
            "expectedEpoch": {
              "$ref": "#/components/schemas/Epoch"
            },
            "currentEpoch": {
              "$ref": "#/components/schemas/Epoch"
            },
            "currentSettings": {
              "$ref": "#/components/schemas/Settings"
            },
            "refreshRequired": {
              "type": "boolean"
            },
            "retryAfterSeconds": {
              "type": "integer",
              "minimum": 1
            },
            "scopeID": {
              "$ref": "#/components/schemas/EntityID"
            }
          }
        },
        "fieldErrors": {
          "type": "object",
          "additionalProperties": false,
          "required": [],
          "properties": {
            "login": {
              "type": "string"
            },
            "password": {
              "type": "string"
            },
            "currentPassword": {
              "type": "string"
            },
            "newPassword": {
              "type": "string"
            },
            "displayName": {
              "type": "string"
            },
            "email": {
              "type": "string"
            }
          }
        },
        "sessionRevoked": {
          "type": "boolean"
        }
      },
      "description": "Typed failure. RateLimited (429) carries the Retry-After header and details.retryAfterSeconds and always has outcome not_committed. ServiceUnavailable (503) from the admission store before the request was dispatched is not_committed for a write and unavailable for a read; there is no AdmissionUnavailable code. A failure after dispatch keeps its earlier code (ServiceUnavailable or UpstreamTimeout) with outcome unknown. CommandConflict is the only code for a reused command identity with different input and for a repeat whose stored result no longer exists (outcome unknown); CommandIdentityConflict does not exist. LimitExceeded is 409 for quotas and 503 for existing page reads (C53).",
      "allOf": [
        {
          "if": {
            "properties": {
              "code": {
                "const": "RateLimited"
              }
            },
            "required": [
              "code"
            ]
          },
          "then": {
            "required": [
              "details"
            ],
            "properties": {
              "outcome": {
                "const": "not_committed"
              },
              "details": {
                "required": [
                  "retryAfterSeconds"
                ]
              }
            }
          }
        }
      ]
    },
    "ID": {
      "type": "string",
      "minLength": 1,
      "description": "Opaque identifier of at most 256 code points. Unicode and reserved characters are allowed. Percent-encode query values; do not require UUID syntax. Owners check the length before any write; a longer value is 400 InvalidArgument with outcome not_committed (C43).",
      "maxLength": 256
    },
