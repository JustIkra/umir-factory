{
  "openapi": "3.1.0",
  "info": {
    "title": "Umir DUR1 public durable-stack supplement",
    "version": "1.0.0"
  },
  "paths": {},
  "components": {
    "schemas": {
      "ExpiryDueList": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "runtimeEpoch",
          "asOf",
          "items"
        ],
        "properties": {
          "runtimeEpoch": {
            "$ref": "#/components/schemas/Epoch",
            "description": "Storage generation of Warehouse that produced the page."
          },
          "asOf": {
            "$ref": "#/components/schemas/Instant"
          },
          "items": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/ExpiryDueRestaurant"
            },
            "minItems": 0,
            "maxItems": 1000
          },
          "nextAfter": {
            "type": "string",
            "minLength": 1,
            "maxLength": 256,
            "description": "Opaque cursor for the next page; absent on the last page."
          }
        },
        "description": "Restaurants whose nextDueAt is at or before asOf, in a stable order, page by page. It requires the cell-level expiry.due service token and reveals no business data."
      },
      "ExpiryDueRestaurant": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "restaurantID",
          "nextDueAt"
        ],
        "properties": {
          "restaurantID": {
            "$ref": "#/components/schemas/EntityID"
          },
          "nextDueAt": {
            "$ref": "#/components/schemas/Instant",
            "description": "Earliest instant with an expiry transition due for this restaurant."
          }
        }
      },
      "HealthReadiness": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "capabilities"
        ],
        "properties": {
          "instance": {
            "type": "string",
            "minLength": 1,
            "maxLength": 128,
            "description": "Replica identifier (INSTANCE_ID). Absent at the frontend."
          },
          "generation": {
            "$ref": "#/components/schemas/Epoch",
            "description": "Storage generation. Absent at services without storage: Gateway (C49) and the frontend (C42)."
          },
          "capabilities": {
            "type": "object",
            "minProperties": 1,
            "maxProperties": 16,
            "propertyNames": {
              "pattern": "^[a-z][a-z0-9_]*$",
              "maxLength": 64
            },
            "additionalProperties": {
              "type": "string",
              "enum": [
                "ok",
                "degraded",
                "down"
              ]
            },
            "description": "State of each capability. The names are fixed per service in docs/durable/configuration.md."
          }
        },
        "description": "Body of GET /readyz (C32). The frontend answers {\"capabilities\":{\"static\":\"ok\"}} without instance and generation."
      },
      "RegistryPoint": {
        "description": "Point read of one restaurant. registryRevision is the revision at which it was read and the ETag value. A restaurant that never existed is 404 NotFound.",
        "oneOf": [
          {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "registryRevision",
              "state",
              "entry"
            ],
            "properties": {
              "registryRevision": {
                "$ref": "#/components/schemas/Version"
              },
              "state": {
                "const": "live"
              },
              "entry": {
                "$ref": "#/components/schemas/RegistryEntry"
              }
            }
          },
          {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "registryRevision",
              "state",
              "tombstone"
            ],
            "properties": {
              "registryRevision": {
                "$ref": "#/components/schemas/Version"
              },
              "state": {
                "const": "tombstone"
              },
              "tombstone": {
                "$ref": "#/components/schemas/RegistryTombstone"
              }
            }
          }
        ]
      },
      "RegistryTombstone": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "restaurantID",
          "orgID",
          "lifecycleVersion"
        ],
        "properties": {
          "restaurantID": {
            "$ref": "#/components/schemas/EntityID"
          },
          "orgID": {
            "$ref": "#/components/schemas/EntityID"
          },
          "lifecycleVersion": {
            "$ref": "#/components/schemas/Version"
          }
        },
        "description": "A deleted restaurant. Tombstones are kept without time limit and carry no personal data."
      }
    }
  },
