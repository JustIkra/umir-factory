  "x-durable-policy": {
    "profile": "DUR1",
    "status": "Numbers are proposals until G1 unless marked fixed.",
    "epoch": {
      "meaning": "storage generation",
      "changesOnlyOn": [
        "storage reset",
        "restore to an earlier history"
      ],
      "neverChangesOn": [
        "process restart",
        "redeploy",
        "replica change"
      ],
      "runtimeResetOnlyOnConfirmedGenerationReset": true,
      "instanceIdentifierOnTheWire": [
        "SSE epoch",
        "edge stream cursor"
      ]
    },
    "gatewayRemoval": {
      "removeIn": "2.0.0-DUR.2",
      "order": "C7",
      "requires": [
        "gateway-pr-1: Gateway reads the registry by revision and no longer depends on runtime registration",
        "auth-pr: Auth no longer lists Gateway as a peer",
        "gateway-pr-2: Gateway removes the runtime and registry routes and the JWKS check for Auth without sync-contract"
      ],
      "note": "Physical removal is profile 2.0.0-DUR.2 in wave 3. The FIN1 profile used for rollback is not touched."
    },
    "registry": {
      "pageLimitMax": 1000,
      "activeRestaurantsMax": 10000,
      "quotaRefusal": {
        "status": 409,
        "code": "LimitExceeded",
        "outcome": "not_committed"
      },
      "tombstones": "kept without time limit, read through since and the point read",
      "listCarriesLiveRestaurantsOnly": true
    },
    "orderAttempt": {
      "states": [
        "Unseen",
        "Pending",
        "Interrupted",
        "Completed",
        "Rejected"
      ],
      "transitions": [
        "Pending -> Interrupted",
        "Interrupted -> Pending on an exact repeat of the same commit"
      ],
      "newCommandIDForPlacedProposal": {
        "status": 200,
        "result": "the same orderID, no second order"
      }
    },
    "expirySchedule": {
      "list": "GET /internal/warehouse/v2/expiry-due",
      "hint": "nextDueAt in the expiry-runs answer",
      "token": "expiry.due (cell level)"
    },
    "commandConflict": {
      "code": "CommandConflict",
      "replaces": "CommandIdentityConflict",
      "authRepeatAfterResultCleared": {
        "status": 409,
        "outcome": "unknown"
      },
      "repeatGuaranteeEnds": "after the 180-day tombstone a repeat of an old command executes as a new command (C53)"
    },
    "admission": {
      "rateLimited": {
        "status": 429,
        "code": "RateLimited",
        "header": "Retry-After",
        "detail": "details.retryAfterSeconds",
        "outcome": "not_committed"
      },
      "storeUnavailable": {
        "status": 503,
        "code": "ServiceUnavailable",
        "outcomeForWrite": "not_committed",
        "outcomeForRead": "unavailable",
        "newCodes": []
      },
      "failureAfterDispatch": {
        "codes": [
          "ServiceUnavailable",
          "UpstreamTimeout"
        ],
        "outcome": "unknown"
      },
      "perClientBudgets": "Gateway holds every budget per client on public entries of Auth. Auth holds reliable budgets per login, address, code issue and wrong code in Postgres in the same transaction as the action. The private contract carries no client key header."
    },
    "limits": {
      "orderPositionsMax": 200,
      "activeProposalsPerRestaurantMax": 2000,
      "idMaxLength": 256,
      "clientCommandIDMaxLength": 256,
      "overPositions": {
        "status": 400,
        "code": "InvalidArgument",
        "outcome": "not_committed"
      },
      "overActiveProposals": {
        "status": 409,
        "code": "LimitExceeded",
        "outcome": "not_committed"
      },
      "overIdentifierLength": {
        "status": 400,
        "code": "InvalidArgument",
        "outcome": "not_committed"
      },
      "limitExceededStatus": {
        "quota": 409,
        "existingPageReads": 503
      }
    },
    "serviceTokens": {
      "expiry.due": "cell level, no restaurant, only the expiry schedule list",
      "order.resolve": "Serving to Warehouse, one restaurant, storage generation of Warehouse, only GET order-attempts and GET commands",
      "acceptedByWarehouse": [
        "expiry.due",
        "order.resolve"
      ],
      "commitRepeatStaysWithTheClient": true,
      "gatewayReadinessChecked": false
    },
    "aggregateRevision": {
      "auth": "monotonic database sequence value, not consecutive; consumers must not rely on continuity",
      "warehouse": "consecutive within a generation per restaurant stream (see events.md)"
