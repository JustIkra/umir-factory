    "Registry": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "registryRevision",
        "complete",
        "entries",
        "tombstones"
      ],
      "properties": {
        "registryRevision": {
          "$ref": "#/components/schemas/Version",
          "description": "Registry revision at which this page was read. It is also the ETag value."
        },
        "complete": {
          "type": "boolean",
          "description": "True on the last page of the walk."
        },
        "nextAfter": {
          "type": "string",
          "minLength": 1,
          "maxLength": 256,
          "description": "Opaque cursor for the next page; present exactly when complete is false."
        },
        "entries": {
          "type": "array",
          "items": {
            "$ref": "#/components/schemas/RegistryEntry"
          },
          "minItems": 0,
          "maxItems": 1000
        },
        "tombstones": {
          "type": "array",
          "items": {
            "$ref": "#/components/schemas/RegistryTombstone"
          },
          "minItems": 0,
          "maxItems": 1000
        }
      },
      "allOf": [
        {
          "if": {
            "properties": {
              "complete": {
                "const": false
              }
            },
            "required": [
              "complete"
            ]
          },
          "then": {
            "required": [
              "nextAfter"
            ]
          },
          "else": {
            "not": {
              "required": [
                "nextAfter"
              ]
            }
          }
        }
      ],
      "description": "One page of the registry. Without since it lists live restaurants only and tombstones is empty. With since it lists records changed after that revision, including tombstones. A page holds at most limit records (entries plus tombstones), at most 1000. Each record reflects the readiness confirmed by acknowledgement; no live peer status is read (C13). A walk that follows nextAfter takes the registryRevision of its first page as R0 and ends with ?since=R0 to catch up with changes made during the walk. The cell has at most 10000 active restaurants."
    },
